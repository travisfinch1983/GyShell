#!/bin/bash
# One-shot deploy helper (claude1): wait until AI-Lab has no in-flight tasks (a restart KILLS them - watermark
# jobs, caption runs, the nightly RAG index), then `ailab-restart --build`, check one URL, and report over fleet.
#
#   ailab-deploy-when-idle "<what is being deployed>" <verify-url> <string the answer must contain> [max-hours]
#
# e.g. ailab-deploy-when-idle "social scrapers (4dfb89d)" http://127.0.0.1:17889/addons/social/instagram/ '"site":"instagram"' 12
# Run it detached: setsid nohup ailab-deploy-when-idle ... >/dev/null 2>&1 &
WHAT=${1:?what is being deployed}
URL=${2:?verify url}
EXPECT=${3:?expected substring}
HOURS=${4:-10}
LOG=/var/log/ailab-deploy-when-idle.log
say() { echo "$(date -u +%FT%TZ) [$WHAT] $*" >> $LOG; }
fleet() {   # $1 = text
  python3 - "$1" <<'PY'
import json, sys, urllib.request
body = {"sender": "claude1", "to": ["claude1"], "kind": "dm", "body": sys.argv[1]}
try:
    urllib.request.urlopen(urllib.request.Request("http://127.0.0.1:17900/send", json.dumps(body).encode(), {"Content-Type": "application/json"}), timeout=20)
except Exception as e:
    print("fleet send failed:", e)
PY
}
say "waiting for AI-Lab to be idle (max ${HOURS} h)"
for i in $(seq 1 $((HOURS * 12))); do
  n=$(curl -s -m10 http://127.0.0.1:17890/api/notifications/tasks | python3 -c "import json,sys;print(sum(1 for t in json.load(sys.stdin).get('tasks',[]) if t.get('state')=='running'))" 2>/dev/null)
  if [ "$n" = "0" ]; then
    say "idle - ailab-restart --build"
    if ailab-restart --build --reason "deploy: $WHAT" >> $LOG 2>&1; then
      sleep 20
      u=$(curl -s -m20 "$URL")
      say "verify $URL -> ${u:0:200}"
      if echo "$u" | grep -qF "$EXPECT"; then
        fleet "[Claude1 auto-deploy] $WHAT is LIVE: AI-Lab restarted with --build once it went idle; $URL answers as expected. Log: CT152 $LOG"
      else
        fleet "[Claude1 auto-deploy] AI-Lab restarted (--build) for $WHAT, but $URL did not answer as expected: ${u:0:200}. Log: CT152 $LOG"
      fi
    else
      say "ailab-restart failed"
      fleet "[Claude1 auto-deploy] ailab-restart --build FAILED while deploying $WHAT; AI-Lab state unknown - see CT152 $LOG"
    fi
    exit 0
  fi
  say "busy ($n running), retry in 5 min"
  sleep 300
done
say "gave up after ${HOURS} h"
fleet "[Claude1 auto-deploy] gave up waiting for AI-Lab to go idle (${HOURS} h); $WHAT is NOT deployed yet."
