[Unit]
Description=MCP group gate: exposes ONLY the sitemap-enterprise MCPJungle tool group on :8099 (for isolated CT196)
After=network-online.target

[Service]
ExecStart=/opt/mcp-unified-memory/.venv/bin/python /opt/ai-lab-mcp/group-gate.py 8099 sitemap-enterprise
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
