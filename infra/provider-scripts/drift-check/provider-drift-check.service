# Provider-script drift check — the scheduled half of deploy.sh --check.
# PLACEMENT: CT152 (10.0.0.219) — NOT ai-gpu, as this comment used to say. The
# check compares the repo against the DATA DIR, and both live on CT152; it is
# the only host where it can run at all.
#
# 🛑 AILAB_PROVIDER_REPO must point at the `providers` SUBDIRECTORY, matching
# deploy.sh's SRC. Pointing it at the parent makes `rel` include `providers/`,
# so dst becomes .../scripts/providers/providers/foo.sh — every file 'differs'.
# That produced 66 FALSE drift reports on first run; the true count was 1.
# Copy both unit files to /etc/systemd/system/, then:
#   systemctl daemon-reload && systemctl enable --now provider-drift-check.timer
[Unit]
Description=Provider-script drift check (emits per drifted script, host-named)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=AILAB_API_URL=http://10.0.0.219:17890
Environment=AILAB_PROVIDER_REPO=/opt/ai-lab/infra/provider-scripts/providers
ExecStart=/opt/ai-lab-ops/provider-drift-check.sh
