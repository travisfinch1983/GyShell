     try:
@@ -1351,7 +1389,7 @@ def delete_memory(memory_id: str, user_id: str = "") -> str:
     try:
         resp = client.request(
             "DELETE", f"{HIPPOCAMPAI_URL}/v1/memories:delete",
-            json={"memory_id": memory_id, "user_id": user_id or _current_user()},
+            json={"memory_id": memory_id, "user_id": _uid(user_id)},
