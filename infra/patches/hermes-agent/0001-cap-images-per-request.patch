+def cap_request_images(messages: List[Dict[str, Any]], limit: int) -> List[Dict[str, Any]]:
+    """Keep only the newest ``limit`` image parts in an outgoing request.
+
+    [ailab patch] Servers cap images per request (vLLM ``--limit-mm-per-prompt``,
+    "At most 5 image(s) may be provided in one prompt."). ``_strip_historical_media``
+    only runs on compression and only anchors on image-bearing USER turns, so an
+    agent that keeps loading images through TOOLS (vision tool results) grows past
+    the cap and every later turn 400s -- the conversation is bricked. This runs on
+    every request: older image parts become a text note; the stored history is
+    untouched (shallow copies of touched messages only). ``limit <= 0`` disables.
+    """
+    if limit <= 0 or not messages:
+        return messages
+    seen = 0
+    # Walk newest -> oldest, counting image parts; strip anything past the limit.
+    cut: Dict[int, int] = {}  # message index -> number of its images to keep (newest-last within it)
+    for i in range(len(messages) - 1, -1, -1):
+        msg = messages[i]
+        if not isinstance(msg, dict):
+            continue
+        content = msg.get("content")
+        if not isinstance(content, list):
+            continue
+        n = sum(1 for p in content if _is_image_part(p))
+        if not n:
+            continue
+        keep = max(0, min(n, limit - seen))
+        seen += n
+        if keep < n:
+            cut[i] = keep
+    if not cut:
+        return messages
+    result = list(messages)
+    removed = 0
+    for i, keep in cut.items():
+        msg = messages[i]
+        content = msg["content"]
+        total = sum(1 for p in content if _is_image_part(p))
+        drop = total - keep  # drop the OLDEST images within the message (earliest parts)
+        new_parts: List[Any] = []
+        for p in content:
+            if _is_image_part(p) and drop > 0:
+                drop -= 1
+                removed += 1
+                new_parts.append({
+                    "type": "text",
+                    "text": "[older image removed: this request is limited to the newest "
+                            f"{limit} image(s). Re-open it with your image tool if you need it again.]",
+                })
+            else:
+                new_parts.append(p)
+        new_msg = msg.copy()
+        new_msg["content"] = new_parts
+        drop_stale_api_content(new_msg)
+        result[i] = new_msg
+    logger.info("cap_request_images: removed %d older image part(s) (limit %d, had %d)", removed, limit, seen)
+    return result
+
