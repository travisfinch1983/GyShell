+# --- DIAGNOSTIC ONLY (ported in spirit from LightX2V's h3_finite_check) -------
+# Set H3_FINITE_CHECK=1 to log per-block statistics of the residual stream.
+# Reports the FIRST block that goes non-finite AND the first that COLLAPSES
+# (std -> 0), because a uniform field and a NaN field are different failures and
+# the fp16 output we are chasing is uniform, not NaN.
+import os as _h3_os
+
+_H3_CHECK = _h3_os.environ.get("H3_FINITE_CHECK") == "1"
+# LightX2V-V100 recipe: the residual stream is 1.75x over the fp16 ceiling at block 0
+# and 104x by block 49, so it MUST stay fp32. Only the post-LayerNorm activations
+# (O(1) by construction) are fed to the matmuls in fp16, where the int8 kernels take
+# their compute dtype from the activation dtype. Scaling of the two output
+# projections is added only where measurement shows the products overflow.
+_H3_FP16_CACHE = {}
+
+
+def _h3_fp16():
+    """Is the fp32-residual / scaled-fp16-matmul path wanted here?
+
+    Auto-ON for Volta (sm_70) and nothing else. Volta has no bf16, so ComfyUI
+    falls back to fp32 and leaves ~1.7x on the table; every later arch has
+    native bf16 and needs none of this. H3_V100_FP16=0/1 overrides either way.
+
+    Evaluated LAZILY and cached: touching torch.cuda at import time would
+    initialise CUDA before ComfyUI has chosen its devices.
+    """
+    if "v" in _H3_FP16_CACHE:
+        return _H3_FP16_CACHE["v"]
+    env = _h3_os.environ.get("H3_V100_FP16")
+    if env is not None:
+        v = env == "1"
+    else:
+        v = False
+        try:
+            if torch.cuda.is_available():
+                v = torch.cuda.get_device_capability(0) == (7, 0)
+        except Exception:
+            v = False          # never let detection break a render
+    _H3_FP16_CACHE["v"] = v
+    logging.info("H3 mixed-precision path: %s", "ON (Volta)" if v else "off")
+    return v
+_H3_CDTYPE = torch.float16
+_h3_state = {"nonfinite": None, "collapsed": None, "prev_std": None}
+
+
+def _h3_stat(tag, t):
+    if not _H3_CHECK:
+        return
+    f = t.float()
+    finite = bool(torch.isfinite(f).all())
+    std = float(f.std())
+    amax = float(f.abs().max())
+    if not finite and _h3_state["nonfinite"] is None:
+        _h3_state["nonfinite"] = tag
+        logging.error("H3_FINITE first NON-FINITE at %s", tag)
+    if finite and std < 1e-6 and _h3_state["collapsed"] is None:
+        _h3_state["collapsed"] = tag
+        logging.error("H3_FINITE first COLLAPSE (std=%.3g) at %s", std, tag)
+    logging.info("H3_FINITE %-12s finite=%-5s std=%.6g absmax=%.6g dtype=%s",
+                 tag, finite, std, amax, t.dtype)
+
