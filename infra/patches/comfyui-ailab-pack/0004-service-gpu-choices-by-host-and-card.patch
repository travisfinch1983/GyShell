+def match_service(choice, svcs):
+    """A saved service choice -> the service now. Exact label first; then the same GPU @ host with any port (labels saved before
+    2026-10-16 carried the port - a relaunch on another port must not break workflows); then the host alone."""
+    c = str(choice or "").strip()
+    hit = next((s for s in svcs if s["label"] == c), None)
+    if hit or " @ " not in c:
+        return hit
+    gpu, _, hp = c.rpartition(" @ ")
+    host = hp.split(":")[0]
+    return next((s for s in svcs if s["host"] == host and s["label"].split(" @ ")[0] == gpu), None) or \
+        next((s for s in svcs if s["host"] == host), None)
+
