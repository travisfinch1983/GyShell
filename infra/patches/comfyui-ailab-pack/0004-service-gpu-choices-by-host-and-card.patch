+def _accept_saved_choices():
+    """Service / gpu / target dropdowns list what is running NOW, and ComfyUI refuses a saved value that is not in the list. Their
+    values are resolved at run time (by host + card UUID - see remote_models.match_service / _gpu_target), so let any value through:
+    a workflow saved before a model-service relaunch (new port, cards added) keeps running. (2026-10-16)"""
+    import inspect
+    for cls in (_r | _x | _m).values():
+        try:
+            req = cls.INPUT_TYPES()
+        except Exception:  # noqa: BLE001
+            continue
+        names = [n for sec in ("required", "optional") for n in (req.get(sec) or {}) if n in ("service", "gpu", "target")]
+        if not names or hasattr(cls, "VALIDATE_INPUTS"):
+            continue
+        params = [inspect.Parameter(n, inspect.Parameter.POSITIONAL_OR_KEYWORD, default=None) for n in names]
+
+        def _v(cls_, *a, **kw):
+            return True
+        _v.__signature__ = inspect.Signature([inspect.Parameter("cls_", inspect.Parameter.POSITIONAL_OR_KEYWORD)] + params)
+        cls.VALIDATE_INPUTS = classmethod(_v)
+
+
+_accept_saved_choices()
