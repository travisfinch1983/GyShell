@@ -0,0 +1,60 @@
+"""Qwen-Image 2.1 Prompt Enhancer: model ids, bundled system prompts, routing (claude2, 2026-10-16).
+
+Since 2026-10-16 both PE models are Heretic Q4_K_M builds served by ONE llama.cpp router (AI-Lab llama-server-5007, ai-epyc
+5060 Ti #2, at most one loaded; asking for the other swaps it in, ~5 s). The old single id `qwen-image-2.1-pe-i2i` is gone.
+The Heretic builds NEED their bundled system prompts: without them T2I answers in chatty markdown and I2I thinks out loud
+past 1,500 tokens. With them both answer one JSON object and stop:
+  T2I {"rewritten_prompt", "wh_ratio"}    I2I {"rewritten_prompt", "wh_ratio", "ratio_follow"}
+Every PE request sends X-AILab-No-Fallback: 1 - a loading PE then fails fast instead of the proxy's external backup model
+answering (and receiving the images). Reference implementation: ai-lab ops/qwen-pe."""
+import os
+import re
+
+PE_T2I = "qwen-image-2.1-pe-t2i-heretic"
+PE_I2I = "qwen-image-2.1-pe-i2i-heretic"
+AUTO = "auto (t2i without images, i2i with)"
+LEGACY = {"qwen-image-2.1-pe-i2i": None, "qwen-image-2.1-pe-t2i": None}   # retired ids -> picked by images, like AUTO
+SYSTEM_PROMPTS = {"t2i": "/models/Qwen-Image-2.1-PE/T2I-Heretic/GGUF/system_prompt.txt",
+                  "i2i": "/models/Qwen-Image-2.1-PE/I2I-Heretic/GGUF/system_prompt.txt"}
+NO_FALLBACK = {"X-AILab-No-Fallback": "1"}
+_sp_cache = {}
+
+
+def is_pe(model_id):
+    """A local Qwen-Image PE id (or the GGUF path a llama-server reports for one); external '(XX) ...' routes are not."""
+    m = str(model_id or "").lower()
+    return not m.startswith("(") and bool(re.search(r"pe[-_ ]?[ti]2i|[ti]2i[-_ ]?pe", m) or ("qwen-image" in m and "-pe" in m))
+
+
+def resolve(model, has_images):
+    """The id to request: AUTO / a retired id -> by images (i2i when the request carries images)."""
+    m = str(model or "").strip()
+    if not m or m == AUTO or m in LEGACY:
+        return PE_I2I if has_images else PE_T2I
+    return m
+
+
+def kind(model_id, has_images=False):
+    m = str(model_id or "").lower()
+    return "t2i" if "t2i" in m else "i2i" if "i2i" in m else ("i2i" if has_images else "t2i")
+
+
+def system_prompt(model_id, has_images=False):
+    """The bundled system prompt for this PE (cached; re-read when the file changes). '' when unreadable."""
+    p = SYSTEM_PROMPTS[kind(model_id, has_images)]
+    try:
+        mt = os.path.getmtime(p)
+        if _sp_cache.get(p, (None,))[0] != mt:
+            _sp_cache[p] = (mt, open(p, encoding="utf-8").read())
+        return _sp_cache[p][1]
+    except OSError as e:
+        print(f"[AI-Lab PE] no bundled system prompt for {model_id} ({e}) - the Heretic PE may ramble instead of answering JSON")
+        return ""
+
+
+def ratio_fields(obj):
+    """(wh_ratio, ratio_follow) from a parsed PE answer ('' when absent)."""
+    if not isinstance(obj, dict):
+        return "", ""
+    g = lambda k: obj[k].strip() if isinstance(obj.get(k), str) else (str(obj[k]) if obj.get(k) is not None else "")  # noqa: E731
+    return g("wh_ratio") or g("aspect_ratio"), g("ratio_follow")
