+# ── RAM budget + LRU eviction (claude1 2026-10-31, maintenance-claude work order j-mvvx4d47-6ba4) ─────────────────────────────
+# A copy ComfyUI's memory manager moves out of VRAM to make room stays in THIS process's RAM (anon, partly page-locked) until
+# something unloads it - and nothing did: only POST /models/unload removed a copy. 15 days of loads (38 copies) grew the
+# process to 136 GB anon RSS and the CT's 160 GiB memcg OOM-killed it (2026-10-31 04:43Z; the watchdog then restarted
+# llama / comfyui / rvc too). The tiers.py quotas are a different thing: they cap the model FILE caches (RAM drive tmpfs,
+# charged to the host; disk tier), not the weights a loaded copy holds in process memory.
+# Now: when the process's anon RSS is over AILAB_MODELSVC_RAM_BUDGET_GB, the least-recently-used IDLE copies that hold
+# weights in RAM are unloaded (references dropped + gc + ComfyUI's cleanup, so the memory is really freed; the FILE stays in
+# the RAM / disk cache tiers, so a reload takes seconds) until it is under 90 % of the budget. Never evicted: pinned copies,
+# copies in a run / mid-step, copies on a GPU whose queue slot is held or waited for (a running or queued request), copies
+# used in the last AILAB_MODELSVC_RAM_MIN_IDLE_S seconds, plugin kinds (their RAM isn't measurable from here).
+RAM_BUDGET_GB = float(os.environ.get("AILAB_MODELSVC_RAM_BUDGET_GB", "64"))        # 0 = no budget
+RAM_MIN_IDLE_S = float(os.environ.get("AILAB_MODELSVC_RAM_MIN_IDLE_S", "300"))
+RAM_CHECK_S = float(os.environ.get("AILAB_MODELSVC_RAM_CHECK_S", "60"))
+RAM_LOW = 0.90                         # once over the budget, evict down to 90 % of it (hysteresis: no one-copy-a-minute churn)
+RAM_KINDS = ("unet", "te", "vae", "ckpt")
+RAM_KICK = threading.Event()           # set after a new copy loads: check now, not at the next period
+RAM_LOCK = threading.Lock()            # one enforcement pass at a time
+RAM_STATS = {"evictions": 0, "freed_gb": 0.0, "last_check": None, "last_eviction": None, "last_stuck": None, "recent": collections.deque(maxlen=20)}
+
+
+def proc_ram_bytes():
+    """This process's anonymous resident memory (RssAnon) - the number the memcg OOM killer reported (anon-rss)."""
+    try:
+        with open("/proc/self/status") as f:
+            for line in f:
+                if line.startswith("RssAnon:"):
+                    return int(line.split()[1]) * 1024
+    except OSError:
+        pass
+    return 0
+
+
+def _malloc_trim():
+    try:
+        import ctypes
+        ctypes.CDLL("libc.so.6").malloc_trim(0)
+    except Exception:  # noqa: BLE001
+        pass
+
+
+def _ram_patchers(r):
+    if r.base is None:
+        return []
+    if r.kind == "ckpt":
+        ps = [r.base] + [getattr(x, "patcher", None) for x in (getattr(r, "clip", None), getattr(r, "vae", None)) if x is not None]
+    elif r.kind == "unet":
+        ps = [r.base]
+    else:                                   # te (CLIP) / vae (VAE) wrap a ModelPatcher
+        ps = [getattr(r.base, "patcher", None)]
+    return [p for p in ps if p is not None]
+
+
+def ram_bytes_of(r):
+    """Bytes of this copy's weights that are NOT on its GPU, i.e. held in this process's RAM (ComfyUI's own accounting)."""
+    tot = 0
+    for p in _ram_patchers(r):
+        try:
+            tot += max(0, int(p.model_size()) - int(p.loaded_size()))
+        except Exception:  # noqa: BLE001
+            pass
+    return tot
+
+
+def _ram_why_not(k, r, now, pins):
+    """None when copy k may be evicted now, else the reason it may not."""
+    if r.kind not in RAM_KINDS:
+        return "plugin kind"
+    if r.base is None:
+        return "released"
+    if k in pins:
+        return "pinned"
+    if r.run_members > 0 or r.fwd_lock.locked() or r.run_lock.locked():
+        return "in a run"
+    if now - r.last < RAM_MIN_IDLE_S:
+        return f"used {now - r.last:.0f}s ago"
+    lease = LEASES[r.gpu]
+    if lease.holder is not None or lease.queue:
+        return "its GPU is busy / has requests queued"
+    return None
+
+
+def ram_candidates(all_rows=False):
+    """[(key, ram bytes, idle s, reason-or-None)], evictable ones first in LRU order (oldest use first, bigger first on ties)."""
+    now = time.time()
+    with MODELS_LOCK:
+        items = list(MODELS.items())
+    with PINS_LOCK:
+        pins = set(PINS)
+    rows = []
+    for k, r in items:
+        rb = ram_bytes_of(r) if r.kind in RAM_KINDS else 0
+        if rb < 64 * 2 ** 20 and not all_rows:
+            continue                       # (nearly) all in VRAM: evicting it frees no RAM
+        rows.append((k, rb, now - r.last, _ram_why_not(k, r, now, pins), r.last))
+    rows.sort(key=lambda x: (x[3] is not None, x[4], -x[1]))
+    return [x[:4] for x in rows]
+
+
+def ram_evict(k):
+    """Unload copy k if it is still evictable, re-checked under its GPU's exclusive gate. -> RAM bytes it held (0 = skipped)."""
+    import gc
+    g = k[3]
+    with MM(g):                            # no step / load / offload on this card while we take the copy apart
+        with PINS_LOCK:
+            pins = set(PINS)
+        with MODELS_LOCK:
+            r = MODELS.get(k)
+            if r is None or _ram_why_not(k, r, time.time(), pins) is not None:
+                return 0
+            held, idle = ram_bytes_of(r), time.time() - r.last
+            MODELS.pop(k)
+        trace("ram evict", g, kind=k[0], name=k[1], ram_gb=round(held / 2 ** 30, 2))
+        r.release(); del r
+        gc.collect()
+        if hasattr(mm, "cleanup_models_gc"):
+            mm.cleanup_models_gc()
+        mm.cleanup_models(); mm.soft_empty_cache()
+    _malloc_trim()
+    registry_write()
+    RAM_STATS["recent"].append({"at": time.time(), "kind": k[0], "name": k[1], "gpu": g, "ram_gb": round(held / 2 ** 30, 2), "idle_s": round(idle)})
+    return held or 1
+
+
+def ram_enforce(budget_gb=None, dry_run=False):
+    """One pass: over the budget -> evict LRU idle RAM-held copies down to RAM_LOW x budget. -> summary dict."""
+    budget_gb = RAM_BUDGET_GB if budget_gb is None else float(budget_gb)
+    if budget_gb <= 0:
+        return {"ok": True, "enabled": False}
+    if not RAM_LOCK.acquire(blocking=False):
+        return {"ok": False, "error": "an enforcement pass is already running"}
+    try:
+        budget = budget_gb * 2 ** 30
+        cur = start = proc_ram_bytes()
+        RAM_STATS["last_check"] = time.time()
+        out = {"ok": True, "budget_gb": budget_gb, "rss_anon_gb": round(cur / 2 ** 30, 2), "evicted": []}
+        if cur <= budget:
+            return out
+        target, tried = RAM_LOW * budget, set()
+        while cur > target:
+            cands = [c for c in ram_candidates() if c[3] is None and c[0] not in tried]
+            if not cands:
+                if not dry_run and cur > budget and (RAM_STATS["last_stuck"] is None or time.time() - RAM_STATS["last_stuck"] > 600):
+                    RAM_STATS["last_stuck"] = time.time()
+                    why = [(k[0], k[1], k[3], reason) for k, _, _, reason in ram_candidates() if reason][:8]
+                    log(f"ram: {cur / 2 ** 30:.1f} GB anon RSS is over the {budget_gb:g} GB budget and nothing more can be evicted now ({why})")
+                break
+            k, rb, idle, _ = cands[0]
+            tried.add(k)
+            if dry_run:
+                out["evicted"].append({"kind": k[0], "name": k[1], "gpu": k[3], "ram_gb": round(rb / 2 ** 30, 2), "idle_s": round(idle), "dry_run": True})
+                cur -= rb
+                continue
+            held = ram_evict(k)
+            if not held:
+                continue
+            new = proc_ram_bytes()
+            RAM_STATS["evictions"] += 1; RAM_STATS["last_eviction"] = time.time()
+            RAM_STATS["freed_gb"] = round(RAM_STATS["freed_gb"] + max(0, cur - new) / 2 ** 30, 2)
+            log(f"ram: evicted {k[0]} {k[1]} from GPU {k[3]} (idle {idle / 60:.0f} min, {held / 2 ** 30:.1f} GB in RAM) - "
+                f"process anon RSS {cur / 2 ** 30:.1f} -> {new / 2 ** 30:.1f} GB (budget {budget_gb:g} GB)")
+            out["evicted"].append({"kind": k[0], "name": k[1], "gpu": k[3], "ram_gb": round(held / 2 ** 30, 2), "idle_s": round(idle),
+                                   "rss_before_gb": round(cur / 2 ** 30, 2), "rss_after_gb": round(new / 2 ** 30, 2)})
+            cur = new
+        out["rss_anon_after_gb"] = round(cur / 2 ** 30, 2) if not dry_run else None
+        out["freed_gb"] = round(max(0, start - cur) / 2 ** 30, 2) if not dry_run else None
+        return out
+    finally:
+        RAM_LOCK.release()
+
+
+def _ram_loop():
+    while True:
+        RAM_KICK.wait(RAM_CHECK_S)
+        RAM_KICK.clear()
+        try:
+            ram_enforce()
+        except Exception:  # noqa: BLE001
+            traceback.print_exc()
+
+
+def ram_status(detail=False):
+    s = {"budget_gb": RAM_BUDGET_GB, "min_idle_s": RAM_MIN_IDLE_S, "check_s": RAM_CHECK_S, "rss_anon_gb": round(proc_ram_bytes() / 2 ** 30, 2),
+         "evictions": RAM_STATS["evictions"], "freed_gb": RAM_STATS["freed_gb"], "last_check": RAM_STATS["last_check"],
+         "last_eviction": RAM_STATS["last_eviction"], "recent": list(RAM_STATS["recent"])}
+    if detail:
+        s["copies"] = [{"kind": k[0], "name": k[1], "gpu": k[3], "ram_gb": round(rb / 2 ** 30, 2), "idle_s": round(idle), "evictable": why is None, "why_not": why}
+                       for k, rb, idle, why in ram_candidates(all_rows=True)]
+    return s
+
