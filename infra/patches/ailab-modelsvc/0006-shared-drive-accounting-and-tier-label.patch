+def _tree_bytes(d):
+    """Bytes a tree really takes on the drive (allocated blocks)."""
+    tot = 0
+    for r, _, fs in os.walk(d):
+        for f in fs:
+            try:
+                tot += os.lstat(os.path.join(r, f)).st_blocks * 512
+            except OSError:
+                pass
+    return tot
+
+
+def drive_info(fresh=False):
+    """The whole RAM drive as both managers see it (bytes), or None when it can't be read. Memoised 10 s."""
+    now = time.time()
+    if not fresh and _drive_memo["v"] is not None and now - _drive_memo["at"] < 10:
+        return _drive_memo["v"]
+    try:
+        st = os.statvfs(DRIVE)
+    except OSError:
+        return None
+    total, free = st.f_blocks * st.f_frsize, st.f_bavail * st.f_frsize
+    own = _tree_bytes(ROOT) if os.path.isdir(ROOT) else 0
+    outside = max(0, total - free - own)
+    cacher, age = None, None
+    try:
+        c = json.load(open(CACHER_FILE))
+        age = now - float(c.get("updated") or 0)
+        cacher = c if age < CACHER_STALE_S else None
+    except Exception:  # noqa: BLE001
+        pass
+    manifest = int((cacher or {}).get("manifest_bytes") or 0)
+    reserve = max(DRIVE_RESERVE_FRAC, float((cacher or {}).get("reserve_frac") or 0)) * total
+    others_need = max(outside, manifest)
+    q = config()["quota_gb"]
+    quotas = sum(float(v) for k, v in q.items() if k in TIERS or os.path.isdir(os.path.join(ROOT, k))) * 1e9
+    room = max(0.0, total - reserve - others_need)
+    v = {"total": total, "free": free, "reserve": reserve, "modelsvc": own, "outside_modelsvc": outside,
+         "cacher_manifest": manifest if cacher else None, "cacher_file_age_s": round(age) if age is not None else None,
+         "others_need": others_need, "ram_room": room, "quotas_configured": quotas,
+         # a store never holds more than CAP (90 %) of its quota after a copy, so CAP x the quotas must fit the room. Floor
+         # 0.2: a misread usage file must not wipe the RAM stores (the free-space check before every copy still holds).
+         "scale": max(0.2, min(1.0, room / (CAP * quotas))) if quotas > 0 else 1.0}
+    _drive_memo.update(at=now, v=v)
+    return v
+
+
+def ram_scale():
+    """Factor applied to every RAM quota so they fit next to the cacher's manifest on the shared drive (1 = configured)."""
+    d = drive_info()
+    return d["scale"] if d else 1.0
+
+
+def drive_summary():
+    d = drive_info()
+    if not d:
+        return None
+    g = lambda b: None if b is None else round(b / 1e9, 1)  # noqa: E731
+    return {"root": DRIVE, "total_gb": g(d["total"]), "free_gb": g(d["free"]), "reserve_gb": g(d["reserve"]),
+            "modelsvc_gb": g(d["modelsvc"]), "outside_modelsvc_gb": g(d["outside_modelsvc"]),
+            "cacher_manifest_gb": g(d["cacher_manifest"]), "cacher_file_age_s": d["cacher_file_age_s"],
+            "ram_room_gb": g(d["ram_room"]), "ram_quotas_configured_gb": g(d["quotas_configured"]), "ram_quota_scale": round(d["scale"], 3),
+            "rule": "RAM quotas x scale fit in total - reserve - max(cacher manifest, used outside ailab-modelsvc); no copy below the reserve"}
+
+
+def make_room(need, why=""):
+    """Before copying `need` bytes into a RAM store: keep the drive's free space above the reserve, evicting the lowest-scored
+    idle RAM files of ALL kinds first. -> True when the copy fits."""
+    def slack():
+        d = drive_info(fresh=True)
+        return None if d is None else d["free"] - need - d["reserve"]
+    s = slack()
+    if s is None or s >= 0:
+        return True
+    now = time.time()
+    cands = []
+    for tier in list(TIERS.values()):
+        st = tier.ram
+        if not st.ok():
+            continue
+        try:
+            idx = json.load(open(os.path.join(st.dir, "index.json")))
+        except Exception:  # noqa: BLE001
+            continue
+        cands += [(_score(e, now), st, k) for k, e in idx.items() if not (st.in_use.get(k) or e.get("pinned") or k in st.copying)]
+    cands.sort(key=lambda x: x[0])
+    for _, st, k in cands:
+        if s >= 0:
+            break
+
+        def go(idx, st=st, k=k):
+            e = idx.get(k)
+            if e is None or st.in_use.get(k) or e.get("pinned") or k in st.copying:
+                return 0
+            try:
+                os.remove(os.path.join(st.dir, k))
+            except FileNotFoundError:
+                pass
+            idx.pop(k)
+            return e.get("size", 0) or 1
+        if st._locked(go):
+            log(f"{st.label}: evicted {k} - the RAM drive is short of free space for {why or 'a copy'} ({need / 1e9:.1f} GB; shared reserve kept)")
+            s = slack()
+    return s >= 0
+
+
+def drive_prune():
+    """Prune every RAM store to its (scaled) quota - after the cacher's manifest grew, the quotas may have shrunk."""
+    _drive_memo["at"] = 0.0
+    for tier in list(TIERS.values()):
+        try:
+            tier.ram.prune()
+        except Exception as e:  # noqa: BLE001
+            log(f"{tier.ram.label}: prune failed: {e}")
+
+
+def persist_label():
+    """The persistent tier's name for people: "Optane" (px-gpu pmem) or "Disk cache" (ai-epyc zfs dataset /disk-cache)."""
+    lab = (config().get("persist_label") or _PERSIST[1] or "").strip()
+    return {"disk": "Disk cache", "": "persistent cache"}.get(lab.lower(), lab)
