+def failover_rules():
+    """{kind: [gpu indices, in order]}: where a pinned kind may go when its pinned cards are full and what's on them can't be
+    unloaded. Set by Travis in the Model Cache & Placement panel. A kind with no entry never leaves its pinned cards."""
+    rules = _state_host("failover_v2") or {}   # {kind: [GPU UUID]} - only this service's cards count
+    out = {k: [i for i in (gpu_index(u) for u in v) if i is not None] for k, v in rules.items() if v}
+    return {k: v for k, v in out.items() if v}
+
+
+def overflow_gpus(kind, lane=None):
+    """This kind's configured failover cards that can take it right now, in the configured order."""
+    ok = gpus_for(kind, lane)
+    return [i for i in failover_rules().get(kind, []) if i in ok]
+
+
+# ── VRAM room for plugin kinds (claude1 2026-11-04). Detectors, SAM and other plugin kinds load outside ComfyUI's memory manager, so
+# free_idle can't move them: they piled up on their card until SAM failed with 11 GB free elsewhere. This is their eviction. A copy
+# is unloaded outright (the file stays in the RAM / disk tiers, so a reload takes seconds). Never touched: pinned copies, copies in
+# use, and copies looked up in the last PLUGIN_ROOM_MIN_IDLE_S seconds, which is what protects the detector a job fetched just
+# before it asked for SAM.
+PLUGIN_ROOM_MIN_IDLE_S = float(os.environ.get("AILAB_MODELSVC_PLUGIN_ROOM_MIN_IDLE_S", "30"))
+
+
+def plugin_work_bytes(kind):
+    return float((PLUGIN_KINDS.get(kind) or {}).get("work_gb") or 0) * 2**30
+
+
+def plugin_need(kind, name):
+    """VRAM to load a model and run it: the file plus 15 %, plus the kind's working memory."""
+    try:
+        size = model_bytes(kind, name) * 1.15
+    except Exception:  # noqa: BLE001
+        size = 0
+    return size + plugin_work_bytes(kind)
+
+
+def evictable_plugin_copies(g, keep=None, min_idle=None):
+    """[(key, Resident)] of plugin copies on GPU g that may be unloaded, least recently used first."""
+    min_idle = PLUGIN_ROOM_MIN_IDLE_S if min_idle is None else min_idle
+    now = time.time()
+    with MODELS_LOCK:
+        items = [(k, r) for k, r in MODELS.items() if k[3] == int(g) and k != keep and k[0] in PLUGIN_KINDS
+                 and PLUGIN_KINDS[k[0]].get("unload") and k not in PINS]
+    idle_ones = [(k, r) for k, r in items if now - r.last >= min_idle and r.run_members == 0 and not r.fwd_lock.locked()]
+    return sorted(idle_ones, key=lambda kr: kr[1].last)
+
+
+def evictable_plugin_bytes(g):
+    total = 0
+    for k, _ in evictable_plugin_copies(g):
+        try:
+            total += model_bytes(k[0], k[1])
+        except Exception:  # noqa: BLE001
+            pass
+    return total
+
+
+# An overflow copy sits on a card its kind isn't pinned to, usually one doing diffusion work, and a diffusion load can't move it
+# (same reason as above). So it only stays while it's in use.
+OVERFLOW_IDLE_S = float(os.environ.get("AILAB_MODELSVC_OVERFLOW_IDLE_S", "120"))
+
+
+def overflow_sweep_once():
+    rules = placement_rules()
+    with MODELS_LOCK:
+        cards = {k[3] for k in MODELS if k[0] in PLUGIN_KINDS and rules.get(k[0]) and k[3] not in rules[k[0]]}
+    for g in cards:
+        if LEASES[g].holder is not None:
+            continue                       # busy: look again next pass
+
+        def sweep(gg):
+            for k, _ in evictable_plugin_copies(gg, min_idle=OVERFLOW_IDLE_S):
+                if rules.get(k[0]) and gg not in rules[k[0]]:
+                    unload(k[0], k[1], k[2], k[3])
+                    log(f"overflow copy of {k[0]} {k[1]} idle {OVERFLOW_IDLE_S:.0f}s: unloaded from GPU {gg}")
+        op_once(Session("overflow sweep"), g, sweep)
+
+
+def overflow_sweep_loop():
+    while True:
+        time.sleep(30)
+        try:
+            overflow_sweep_once()
+        except Exception:  # noqa: BLE001
+            traceback.print_exc()
+
+
+def plugin_make_room(g, need, keep=None, min_idle=None):
+    """Unload idle plugin copies on GPU g, oldest first, then idle ComfyUI-managed models, until `need` bytes are free. Call it
+    holding the card's queue slot and outside GATE.compute. Returns the free bytes afterwards."""
+    d = GPUS[int(g)]
+    if d.type != "cuda":
+        return 0
+    free = mm.get_free_memory(d)
+    if free >= need:
+        return free
+    for k, _ in evictable_plugin_copies(g, keep, min_idle):
+        try:
+            unload(k[0], k[1], k[2], k[3])
+        except Exception as e:  # noqa: BLE001
+            log(f"VRAM room: could not unload {k[0]} {k[1]} from GPU {g}: {e}")
+            continue
+        free = mm.get_free_memory(d)
+        log(f"VRAM room: unloaded idle {k[0]} {k[1]} from GPU {g}, {free / 2**30:.1f} GB free, need {need / 2**30:.1f}")
+        if free >= need:
+            return free
+    return free_idle(int(g), need)
+
