# HippocampAI — copy to .env and fill from the credential vault. NEVER COMMIT .env.
# Live reference: /opt/HippocampAI/.env on CT26.

# --- Embeddings ---
# The local-embedder path pulls in torch (~5.6GB). Our patch adds a REMOTE
# OpenAI-compatible path — prefer it, and keep torch out of the image.
EMBED_API_URL=http://ai-lab:17890/api/proxy/embed/v1
EMBED_API_MODEL=Qwen3-VL-Embedding-8B
EMBED_DIMENSION=4096
EMBED_BATCH_SIZE=32
# RERANKER_MODEL=  # leave UNSET: rag-models.json already selects a remote reranker

# --- LLM (extraction) ---
# TODO: this should DERIVE from AI-Lab Support Models rather than being pinned
# here. Hardcoding it is exactly what broke extraction on 2026-07-27 (task #77):
# the pinned model went offline and extraction silently returned []. Whatever is
# chosen must be a NON-THINKING instruct model — a thinking model's output does
# not match hippo's strict JSON schema and it falls back to a useless heuristic.
LLM_PROVIDER=openai
LLM_MODEL=CHANGEME
LLM_BASE_URL=http://ai-lab:17890/api/proxy/llm/v1
CONFLICT_CHECK_LLM=true
OPENAI_API_KEY=CHANGEME_FROM_VAULT

# --- Vector store (patch adds the backend switch) ---
VECTOR_BACKEND=qdrant
QDRANT_URL=http://qdrant:6333
# MILVUS_URI=http://milvus:19530

# --- Local deps: now separate compose services, not localhost ---
REDIS_URL=redis://redis:6379
REDIS_DB=0
REDIS_CACHE_TTL=300
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=hippocampai
POSTGRES_USER=hippocampai
POSTGRES_PASSWORD=CHANGEME_FROM_VAULT
