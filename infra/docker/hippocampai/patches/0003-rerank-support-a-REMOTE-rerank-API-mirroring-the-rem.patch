From d2867fcdacd8bba7d3922aa901c2805d6cde864c Mon Sep 17 00:00:00 2001
From: claude <claude@deeveeyant.com>
Date: Mon, 27 Jul 2026 17:07:50 +0000
Subject: [PATCH 3/3] rerank: support a REMOTE rerank API, mirroring the
 remote-embedder patch
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

sentence-transformers is the only dependency that pulls torch (~5.6GB), and after
the embedder patch it was needed solely for the local CrossEncoder reranker.

Adds RERANK_API_URL / RERANK_API_MODEL (+ RERANK_API_TIMEOUT). When set, scoring
goes to an OpenAI-style /rerank endpoint — {model, query, documents} ->
{results:[{index, relevance_score}]} — and the sentence_transformers import is
DEFERRED into the local branch so torch is never imported at all. Verified: the
running process shows 0 torch mappings before and after a rerank.

Two wins beyond image size: the endpoint takes one query + many documents, which
matches how rerank() batches anyway; and we now share the SAME reranker the rest
of the stack already selects via rag-models.json instead of running a second,
different cross-encoder that could silently disagree with the unified memory MCP.

Remote failures log a warning and return 0.0 scores, so callers still get results
in RRF/original order rather than an exception.
---
 src/hippocampai/retrieval/rerank.py | 114 ++++++++++++++++++----------
 1 file changed, 76 insertions(+), 38 deletions(-)

diff --git a/src/hippocampai/retrieval/rerank.py b/src/hippocampai/retrieval/rerank.py
index 1ee8402..ca5ea1b 100755
--- a/src/hippocampai/retrieval/rerank.py
+++ b/src/hippocampai/retrieval/rerank.py
@@ -1,9 +1,18 @@
-"""CrossEncoder reranker with caching."""
+"""Reranker with caching — supports a local CrossEncoder or a REMOTE rerank API.
+
+Mirrors the remote-embedder patch in hippocampai/embed/embedder.py: when
+RERANK_API_URL is set we call an OpenAI-style /rerank endpoint and NEVER import
+sentence_transformers, which is the only dependency that pulls in torch (~5.6GB).
+That also means we share the one reranker the rest of the stack already uses
+(rag-models.json selects it) instead of running a second, different cross-encoder
+that could silently disagree with the unified memory MCP's ranking.
+"""
 
 import hashlib
+import json
 import logging
-
-from sentence_transformers import CrossEncoder
+import os
+import urllib.request
 
 from hippocampai.utils.cache import get_cache
 
@@ -14,31 +23,76 @@ class Reranker:
     def __init__(
         self, model_name: str = "cross-encoder/ms-marco-MiniLM-L-6-v2", cache_ttl: int = 86400
     ):
-        self.model = CrossEncoder(model_name)
+        self.model = None
         self.cache = get_cache(ttl=cache_ttl)
-        logger.info(f"Loaded reranker: {model_name}")
+
+        # Read env at init (after dotenv has loaded), same as Embedder.
+        api_url = os.environ.get("RERANK_API_URL", "")
+        api_model = os.environ.get("RERANK_API_MODEL", "")
+        self.use_remote = bool(api_url)
+
+        if self.use_remote:
+            self.api_url = api_url.rstrip("/")
+            self.api_model = api_model or model_name
+            self.timeout = float(os.environ.get("RERANK_API_TIMEOUT", "15") or 15)
+            logger.info(f"Using remote reranker: {self.api_url} model={self.api_model}")
+        else:
+            # Deferred import: keeps torch out of the image entirely when remote.
+            from sentence_transformers import CrossEncoder
+
+            self.model = CrossEncoder(model_name)
+            logger.info(f"Loaded local reranker: {model_name}")
+
+    def _remote_predict(self, pairs: list) -> list[float]:
+        """Score [[query, doc], ...] via the remote /rerank endpoint.
+
+        The endpoint takes ONE query + many documents, so pairs are grouped by
+        query. Response shape: {"results":[{"index":i,"relevance_score":s},...]}
+        where index refers to position in the documents list we sent.
+        Any failure returns 0.0 scores — callers still get RRF/original order.
+        """
+        scores = [0.0] * len(pairs)
+        by_query: dict[str, list[int]] = {}
+        for i, (q, _doc) in enumerate(pairs):
+            by_query.setdefault(q, []).append(i)
+
+        for query, idxs in by_query.items():
+            documents = [pairs[i][1] for i in idxs]
+            try:
+                data = json.dumps(
+                    {"model": self.api_model, "query": query, "documents": documents}
+                ).encode()
+                req = urllib.request.Request(
+                    f"{self.api_url}/rerank",
+                    data=data,
+                    headers={"Content-Type": "application/json"},
+                )
+                with urllib.request.urlopen(req, timeout=self.timeout) as r:
+                    payload = json.loads(r.read().decode())
+                for item in payload.get("results", []):
+                    pos = item.get("index")
+                    if isinstance(pos, int) and 0 <= pos < len(idxs):
+                        scores[idxs[pos]] = float(item.get("relevance_score", 0.0))
+            except Exception as e:
+                logger.warning(f"Remote rerank failed ({e}); falling back to 0.0 scores")
+
+        return scores
+
+    def _predict(self, pairs: list) -> list[float]:
+        if self.use_remote:
+            return self._remote_predict(pairs)
+        return [float(s) for s in self.model.predict(pairs)]
 
     def rerank(
         self, query: str, candidates: list[tuple[str, str, float]], top_k: int = 20
     ) -> list[tuple[str, str, float, float]]:
-        """
-        Rerank candidates using CrossEncoder.
-
-        Args:
-            query: Search query
-            candidates: [(id, text, orig_score), ...]
-            top_k: Number of top results to return
-
-        Returns:
-            [(id, text, orig_score, rerank_score), ...]
-        """
+        """Rerank candidates. Returns [(id, text, orig_score, rerank_score), ...]."""
         if not candidates:
             return []
 
         query_hash = hashlib.md5(query.encode(), usedforsecurity=False).hexdigest()
         results = []
 
-        # Try cache first
         cached_scores = {}
         uncached_pairs = []
         uncached_indices = []
@@ -52,43 +106,27 @@ class Reranker:
                 uncached_pairs.append([query, text])
                 uncached_indices.append(idx)
 
-        # Compute uncached scores
         if uncached_pairs:
-            scores = self.model.predict(uncached_pairs)
+            scores = self._predict(uncached_pairs)
             for i, score in enumerate(scores):
                 idx = uncached_indices[i]
                 doc_id = candidates[idx][0]
-                cache_key = f"{query_hash}:{doc_id}"
-                self.cache.set(cache_key, float(score))
+                self.cache.set(f"{query_hash}:{doc_id}", float(score))
                 cached_scores[idx] = float(score)
 
-        # Build results
         for idx, (doc_id, text, orig_score) in enumerate(candidates):
-            rerank_score = cached_scores[idx]
-            results.append((doc_id, text, orig_score, rerank_score))
+            results.append((doc_id, text, orig_score, cached_scores[idx]))
 
-        # Sort by rerank score
         results.sort(key=lambda x: x[3], reverse=True)
         return results[:top_k]
 
     def rerank_single(self, text1: str, text2: str) -> float:
-        """
-        Compute similarity score between two texts using CrossEncoder.
-
-        Args:
-            text1: First text
-            text2: Second text
-
-        Returns:
-            Similarity score (higher is more similar)
-        """
-        # Create cache key from both texts
+        """Similarity score between two texts."""
         cache_key = hashlib.md5(f"{text1}:{text2}".encode(), usedforsecurity=False).hexdigest()
         cached = self.cache.get(cache_key)
         if cached is not None:
             return float(cached)
 
-        # Compute score
-        score = float(self.model.predict([[text1, text2]])[0])
+        score = float(self._predict([[text1, text2]])[0])
         self.cache.set(cache_key, score)
         return score
