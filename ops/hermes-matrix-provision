#!/usr/bin/env python3
"""hermes-matrix-provision <profile> [--name "Display Name"] [--allow @a:hs,@b:hs] [--force]

Give a Hermes agent its Matrix channel, using only native Hermes capabilities (env vars +
`hermes gateway install/restart`), never a source patch:

  1. bot account @<profile>:deeveeyant.com, via the restricted key whose ONLY power is the VPS
     script matrix-bot-provision (it opens token-only sign-ups under a lock, registers, and
     restores the exact previous mode, so approval-mode suspension never hits the bot)
  2. an ENCRYPTED DM room created by the bot, inviting the allowed users. Hermes does E2EE
     (MATRIX_E2EE_MODE=optional), so unlike the Claude Code channel plugin it can stay encrypted
  3. MATRIX_* block in the profile .env. Any inherited MATRIX_* lines are stripped FIRST:
     `hermes profile create --clone` copies the default profile's .env, and an inherited access
     token would make two agents share one bot
  4. gateway: install the systemd unit if missing, else restart; wait until gateway_state.json
     reports matrix connected; keep the recovery key it writes as MATRIX_RECOVERY_KEY
  5. credentials into the AI-Lab vault

Idempotent: a profile whose .env already has MATRIX_ACCESS_TOKEN is skipped unless --force.
Prints one final line: OK <json> | SKIP <reason> | ERROR <reason>. Exit status 0 only for OK/SKIP.
"""
import argparse, json, os, re, subprocess, sys, time, urllib.request, urllib.error

HS = "https://matrix.deeveeyant.com"
VPS = "root@107.173.17.151"
KEY = "/root/.ssh/matrix_provision_key"
PROFILES = "/root/.hermes/profiles"
HERMES = "/usr/local/bin/hermes"
VAULT = "http://127.0.0.1:17890/api/ai/credentials"
OWNER = "@travis:deeveeyant.com"
# Template profiles are blueprints, never chatted with (services/Hermes/templateProfiles.ts).
TEMPLATES = {"default"}


def die(msg):
    print(f"ERROR {msg}")
    print(f"ERROR {msg}", file=sys.stderr)   # AI-Lab's runner surfaces only stderr on failure
    sys.exit(1)


def mx(method, path, token, body=None):
    req = urllib.request.Request(HS + path, json.dumps(body).encode() if body is not None else None,
                                 {"Content-Type": "application/json", "Authorization": f"Bearer {token}"},
                                 method=method)
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            return r.status, json.loads(r.read() or b"{}")
    except urllib.error.HTTPError as e:
        return e.code, json.loads(e.read() or b"{}")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("profile")
    ap.add_argument("--name")
    ap.add_argument("--allow", default=OWNER)
    ap.add_argument("--force", action="store_true")
    a = ap.parse_args()
    p = a.profile
    if p in TEMPLATES:
        print(f"SKIP {p} is a template profile"); return
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]{1,39}", p):
        die(f"profile '{p}' is not a valid Matrix localpart")
    home = f"{PROFILES}/{p}"
    envp = f"{home}/.env"
    if not os.path.isdir(home):
        die(f"no profile at {home}")
    env = open(envp).read() if os.path.exists(envp) else ""
    if re.search(r"^MATRIX_ACCESS_TOKEN=\S", env, re.M) and not a.force:
        print(f"SKIP {p} already has a Matrix channel"); return
    allow = [u.strip() for u in a.allow.split(",") if u.strip()]
    for u in allow:
        if not re.fullmatch(r"@[a-z0-9._=/-]+:[a-z0-9.-]+", u):
            die(f"bad Matrix user id in --allow: {u}")
    name = a.name or p.replace("-", " ").title()

    # 1. account
    r = subprocess.run(["ssh", "-i", KEY, "-o", "BatchMode=yes", "-o", "ConnectTimeout=15", VPS, p],
                       capture_output=True, text=True, timeout=120)
    line = next((l for l in r.stdout.splitlines() if l.startswith("RESULT: ")), None)
    if not line:
        die(f"account provisioning failed: {(r.stdout + r.stderr).strip()[:300]}")
    acct = json.loads(line[8:])
    uid, tok, dev = acct["user_id"], acct["access_token"], acct.get("device_id")

    # 2. profile + encrypted DM room
    mx("PUT", f"/_matrix/client/v3/profile/{uid}/displayname", tok, {"displayname": name})
    st, room = mx("POST", "/_matrix/client/v3/createRoom", tok, {
        "preset": "trusted_private_chat", "is_direct": True, "invite": allow, "name": name,
        "topic": f"{name} (Hermes agent '{p}')",
        "initial_state": [{"type": "m.room.encryption", "state_key": "",
                           "content": {"algorithm": "m.megolm.v1.aes-sha2"}}]})
    rid = room.get("room_id")
    if st != 200 or not rid:
        die(f"createRoom failed ({st}): {room}")
    for u in allow:
        mx("PUT", f"/_matrix/client/v3/user/{uid}/account_data/m.direct", tok, {u: [rid]})

    # 3. .env — strip inherited/old MATRIX_* first, then append ours
    keep = [l for l in env.splitlines() if not re.match(r"\s*#?\s*MATRIX_", l)
            and "--- Matrix" not in l]
    rk_file = f"{home}/platforms/matrix/recovery-key.txt"
    os.makedirs(os.path.dirname(rk_file), exist_ok=True)
    block = [
        "", f"# --- Matrix (hermes-matrix-provision {time.strftime('%Y-%m-%d')}) — bot {uid}, creds in the AI-Lab vault ---",
        f"MATRIX_HOMESERVER={HS}", f"MATRIX_USER_ID={uid}", f"MATRIX_ACCESS_TOKEN={tok}",
        f"MATRIX_DEVICE_ID={dev}", "MATRIX_E2EE_MODE=optional",
        f"MATRIX_RECOVERY_KEY_OUTPUT_FILE={rk_file}",
        f"MATRIX_ALLOWED_USERS={','.join(allow)}", f"MATRIX_HOME_ROOM={rid}",
    ]
    if os.path.exists(envp):
        subprocess.run(["cp", "-a", envp, f"{envp}.pre-matrix-{time.strftime('%Y%m%d-%H%M%S')}"])
    with open(envp, "w") as f:
        f.write("\n".join(keep).rstrip("\n") + "\n" + "\n".join(block) + "\n")
    os.chmod(envp, 0o600)

    # 4. gateway
    unit = f"hermes-gateway-{p}"
    has_unit = subprocess.run(["systemctl", "cat", f"{unit}.service"], capture_output=True).returncode == 0
    if has_unit:
        subprocess.run(["systemctl", "restart", unit], timeout=60)
    else:
        r = subprocess.run([HERMES, "-p", p, "gateway", "install", "--system", "--run-as-user", "root", "--no-start-now"],
                           capture_output=True, text=True, timeout=120, input="")
        if subprocess.run(["systemctl", "cat", f"{unit}.service"], capture_output=True).returncode != 0:
            die(f"gateway install did not create {unit}.service: {(r.stdout + r.stderr).strip()[-300:]}")
        subprocess.run(["systemctl", "enable", "--now", unit], timeout=60)
    state = "unknown"
    for _ in range(30):   # ~60 s: AI-Lab's runner times out at 90 s
        time.sleep(2)
        try:
            gs = json.load(open(f"{home}/gateway_state.json"))
            state = (gs.get("platforms", {}).get("matrix") or {}).get("state", "absent")
            if state == "connected":
                break
        except Exception:
            pass
    if state != "connected":
        die(f"gateway did not report matrix connected (last: {state}) — check journalctl -u {unit}")
    if os.path.exists(rk_file):
        rk = "".join(l.strip() for l in open(rk_file) if l.strip() and not l.startswith("#"))
        if rk:
            with open(envp, "a") as f:
                f.write(f"MATRIX_RECOVERY_KEY={rk}\n")
            os.chmod(rk_file, 0o600)

    # 5. vault (best effort)
    try:
        body = json.dumps({"name": f"Matrix bot {uid}", "type": "user_pass", "url": HS, "username": uid,
                           "password": acct.get("password", ""), "bearerToken": tok,
                           "notes": f"Hermes agent '{p}' Matrix gateway bot (hermes-matrix-provision). Device {dev}. "
                                    f"Encrypted DM room {rid}; allowed: {','.join(allow)}."}).encode()
        urllib.request.urlopen(urllib.request.Request(VAULT, data=body, headers={"Content-Type": "application/json"},
                                                      method="POST"), timeout=10).read()
    except Exception as e:
        print(f"warning: vault store failed: {e}", file=sys.stderr)

    print("OK " + json.dumps({"profile": p, "user_id": uid, "room_id": rid, "allowed": allow}))


if __name__ == "__main__":
    main()
